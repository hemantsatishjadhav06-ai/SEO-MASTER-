# Railway (and other generic container hosts) image for the OpenSEO marketing
# site (web/).
#
# The marketing site imports a few modules from the root app (e.g.
# src/client/features/ai-mcp/agentSetupPrompt and a .agents skill markdown
# file), so it can only be built with the whole repository as the build
# context — a web/-only context fails to resolve those ../../../src imports.
# The build context is therefore the repository root; this image installs and
# builds inside web/ and serves the result with vite preview.
FROM node:22

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app

# Pin pnpm; web/ has no packageManager field, so corepack would otherwise fetch
# a newer pnpm that hard-fails the install over ignored build scripts.
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

# Whole repo (root .dockerignore trims node_modules/dist/.git) so web's build can
# reach into the root app's src/ and .agents/ for its shared imports.
COPY . .

WORKDIR /app/web
RUN pnpm install --frozen-lockfile
RUN pnpm run build

EXPOSE 3000

# SERVE_HOST=:: (set on the Railway service) gives a dual-stack listener so
# Railway's IPv6 private network / healthcheck can reach it.
CMD ["sh", "-c", "pnpm exec vite preview --host ${SERVE_HOST:-0.0.0.0} --port ${PORT:-3000}"]
